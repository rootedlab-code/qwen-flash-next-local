# Copy to `.env` at the repo root and edit. Every value is optional: what is
# shown here is the built-in default. `.env` is gitignored.

# --- where llama.cpp lives ---------------------------------------------------
# The build must carry PR #27836 (qwen4exp MTP) for --spec-type draft-mtp.
#LLAMA_CPP_DIR="$HOME/llama.cpp"
#LLAMA_BIN_DIR="$LLAMA_CPP_DIR/build/bin"

# --- where the weights live --------------------------------------------------
# Put them on the fastest UNENCRYPTED filesystem you have. On the reference
# machine this alone was worth 8.91 t/s instead of 4.34 t/s.
#MODEL_DIR="$HOME/models"
#MODEL="$MODEL_DIR/Qwen3.8-Flash-Next-Uncensored-IQ4_XS-MTP-00001-of-00004.gguf"

# --- scratch space -----------------------------------------------------------
# Logs and benchmark output. Never point this at /tmp if /tmp is tmpfs.
#WORK_DIR="$REPO_ROOT/work"

# --- tuned knobs -------------------------------------------------------------
# Expert layers left on the CPU. Lower = more layers in VRAM = faster, until
# the load dies with cudaMalloc failed. 46 fits 8 GB; see README.md.
#NCMOE=46
#THREADS=12
#UBATCH=256
#CTX=32768
#PORT=8081
